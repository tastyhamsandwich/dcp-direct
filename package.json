{
  "name": "dcp-direct",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "devnet": "next dev --turbopack -p 3000 -H 127.0.0.1",
    "dev": "next dev --turbopack -p 3000",
    "devsock": "tsx src/server.ts",
    "dev:all": "concurrently \"pnpm devsock\" \"pnpm dev\"",
    "dev:net": "concurrently \"pnpm devnet\" \"pnpm devsock\"",
    "dev:net:test": "concurrently \"pnpm devsock\" \"HOSTNAME=0.0.0.0 PORT=3003 next dev\"",
    "test": "jest",
    "test-server": "DEBUG=express:* tsx src/test.ts",
    "start": "next start",
    "build": "next build",
    "lint": "next lint",
    "test:pinochle": "jest --runTestsByPath tests/pinochle.test.ts",
    "dev:sculpt": "concurrently \"pnpm dev\" \"pnpm devsock\" \"sculpt\"",
    "dev:sculpt:net": "concurrently \"pnpm devnet\" \"pnpm devsock\" \"sculpt\""
  },
  "browser": {
    "child_process": false
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "express": "^5.2.1",
    "framer-motion": "^12.23.26",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.561.0",
    "mongodb": "^7.0.0",
    "mongoose": "^9.0.2",
    "next": "16.0.10",
    "nodemailer": "^7.0.11",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "react-image-crop": "^11.0.10",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "stripe": "^20.1.0",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.0.10",
    "jest": "^30.2.0",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "core-js",
      "core-js-pure",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
