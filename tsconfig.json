{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["node"],
    "plugins": [{"name": "next" }],
    "paths": {
      "@comps/*": ["./src/components/*"],
      "@components/*": ["./src/components/*"],
      "@contexts/*": ["./src/contexts/*"],
      "@lib/*": ["./src/lib/*"],
      "@app/*": ["./src/app/*"],
      "@/*": ["./src/*"],
      "@socket": ["./socket"],
      "@game/*": ["./src/game/*"],
      "@utils/*": ["./src/lib/utils/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@db/*": ["./src/lib/db/*"],
      "@api/*": ["./src/app/api/*"],
      "@mongoose/*": ["./src/lib/mongoose/*"],
      "@schema/*": ["./src/lib/mongoose/schema/*"],
      "@types/*": ["./src/types/*"]
    }
  },
  "include": ["./src/types/**.ts", "src/socket.ts", "./src/*.ts", "next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/server.js", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules", "misc/*.*"]
}
